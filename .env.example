# ==============================================================================
# ARROW GEN - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi '.env' di root folder dan sesuaikan nilainya:
#   cp .env.example .env
#
# PENTING:
# JANGAN PERNAH MENYIMPAN FILE '.env' KE GIT ATAU MEMBAGIKAN DATABASE CREDENTIALS!
# Untuk Vercel: Tambahkan variabel-variabel di bawah pada menu Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Neon PostgreSQL Serverless)
# ------------------------------------------------------------------------------
# URL koneksi PostgreSQL dari dashboard Neon (https://console.neon.tech).
# Pastikan query parameter '?sslmode=require' selalu disertakan untuk keamanan SSL/TLS.
# Format: postgresql://<user>:<password>@<neon-hostname>/<database>?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BETTER AUTH CONFIGURATION (Internal Authentication & Session)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani cookies sesi dan token JWT.
# Di lingkungan produksi, gunakan string acak minimal 32 karakter.
# Tips pembuatan di terminal: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-random-key-min-32-chars"

# Base URL publik aplikasi:
# - Lokal: http://localhost:3000
# - Produksi Vercel: https://arrow-gen.vercel.app (atau domain kustom Anda)
# Catatan: Jika tidak diset di Vercel, sistem otomatis mendeteksi $VERCEL_URL.
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. PUBLIC RUNTIME CONFIGURATION (Dapat diakses oleh Klien & Server)
# ------------------------------------------------------------------------------
# Nomor WhatsApp narahubung resmi pastoral / youth leader Arrow Gen.
# Format: Kode negara diikuti nomor telepon tanpa tanda '+' atau spasi (contoh: 6281234567890).
NUXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# ------------------------------------------------------------------------------
# 4. INITIAL ADMIN SEEDING (Opsional / Sekali Pakai)
# ------------------------------------------------------------------------------
# Digunakan oleh skrip 'npm run seed' untuk membuat akun Super Admin pertama.
SEED_ADMIN_NAME="Admin Arrow Gen"
SEED_ADMIN_EMAIL="admin@arrowgen.church"
SEED_ADMIN_PASSWORD="SecureAdminPassword123!"
