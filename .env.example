# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env dan sesuaikan nilainya dengan konfigurasi lokal Anda.
# PENTING: JANGAN PERNAH MENYIMPAN ATAU MELAKUKAN COMMIT FILE .env KE GIT REPOSITORY!
# ==============================================================================

# 1. Database Connection URL (Neon PostgreSQL Serverless)
# Format: postgresql://<user>:<password>@<neon-hostname>/<database>?sslmode=require
DATABASE_URL="postgresql://username:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth Configuration
# Secret key untuk menandatangani session/token (minimal 32 karakter acak)
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
# Base URL aplikasi (contoh lokal: http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# 3. Super Admin Seed Configuration (Perintah manual: npm run seed)
# Digunakan oleh server/database/seed.ts untuk inisialisasi akun Super Admin pertama
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"

# 4. Public Runtime Configuration (Aksesibilitas Klien & Server)
# Nomor WhatsApp narahubung resmi Arrow Gen (format internasional tanpa tanda '+')
NUXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
